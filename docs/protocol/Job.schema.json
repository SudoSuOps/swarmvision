{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://swarmvision.io/protocol/v0.2/Job.schema.json",
  "title": "Job",
  "description": "A compute job in the SwarmVision network. This schema is FROZEN as of v0.2.",
  "type": "object",
  "required": [
    "job_id",
    "client_ens",
    "model_id",
    "status",
    "submitted_at"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "description": "Unique job identifier",
      "pattern": "^job_[a-f0-9]{12}$"
    },
    "client_ens": {
      "type": "string",
      "description": "ENS name of the client who submitted the job",
      "pattern": "^[a-z0-9-]+\\.[a-z]+\\.eth$"
    },
    "model_id": {
      "type": "string",
      "description": "Identifier of the model/pipeline to execute",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "description": "Job-specific input data",
      "additionalProperties": true
    },
    "status": {
      "type": "string",
      "enum": ["pending", "assigned", "running", "completed", "failed", "cancelled"],
      "description": "Current job status"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO8601 timestamp when job was submitted"
    },
    "assigned_to": {
      "type": ["string", "null"],
      "description": "ENS name of assigned operator (*.swarmcompute.eth)",
      "pattern": "^[a-z0-9-]+\\.swarmcompute\\.eth$"
    },
    "assigned_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "ISO8601 timestamp when job was assigned"
    },
    "completed_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "ISO8601 timestamp when job was completed"
    },
    "proof_hash": {
      "type": ["string", "null"],
      "description": "Hash of the Proof of Execution",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
